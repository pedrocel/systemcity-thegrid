# ---------- IA ----------
# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, o servidor usa o Claude Code instalado (claude -p).
ANTHROPIC_API_KEY=
# CLAUDE_MODELO=claude-opus-5-5
# AGENTE_MODELO=claude-opus-5-5
# Pedidos ao Claude por pessoa por hora
# IA_POR_HORA=60
# Rodar a auditoria do código sozinha quando um projeto entra (0 desliga)
# AUDITAR_AO_GERAR=1

# ---------- Endereço ----------
# Com HTTPS na frente (proxy), ligue o cookie seguro e diga o endereço público
# SEGURO=1
# ORIGENS=https://systemcity.suaempresa.com

# ---------- Admins ----------
# E-mails (separados por vírgula) que veem o painel de custos de IA em /admin.html
# ADMINS=voce@suaempresa.com

# ---------- E-mail (redefinição de senha) ----------
# RESEND_API_KEY=
# EMAIL_DE=SystemCity <nao-responda@suaempresa.com>

# ---------- Entrar com Google ou Microsoft ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# ---------- Conectar o GitHub pela conta (OAuth App) ----------
# Sem isso, cada pessoa cola um token do GitHub em Projetos → Contas
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------- Incidentes por webhook (Sentry, Datadog...) ----------
# INCIDENTES_TOKEN=

# ---------- Atas ----------
# Nome do seu sistema de tickets no texto da ata
# SISTEMA_TICKETS=Jira

# ---------- Limites por plano (para quem oferece o SystemCity como serviço) ----------
# PLANOS=1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRECO_TIME=
